[Desktop Entry]
Type=Application
Version=1.0
Name=Brave Workspace Manager
GenericName=Brave profile manager
GenericName[es]=Gestor de perfiles de Brave
Comment=Manage the native Brave profiles from a single window
Comment[es]=Administra los perfiles nativos de Brave desde una sola ventana
Exec=@PYTHON@ -m brave_workspace_manager
TryExec=@PYTHON@
Icon=brave-workspace-manager
Terminal=false
Categories=Utility;
Keywords=brave;browser;profiles;workspace;
Keywords[es]=brave;navegador;perfiles;workspace;
StartupNotify=true
StartupWMClass=Brave Workspace Manager
